{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/godup233-hash/future-career-stress-test/schemas/occupation.json",
  "title": "Occupation",
  "description": "An occupation mapped to standard classifications, with its task bundle and per-task AI assessment.",
  "type": "object",
  "required": ["name", "country", "classifications", "tasks"],
  "properties": {
    "name": { "type": "string", "description": "Canonical occupation name (English)" },
    "name_zh": { "type": "string", "description": "Chinese display name" },
    "country": { "type": "string", "description": "ISO 3166-1 alpha-2 of the analysis context" },
    "classifications": {
      "type": "object",
      "description": "Codes in standard systems; include only those applicable",
      "properties": {
        "isco08": { "type": "string", "description": "ISCO-08 4-digit code (global spine)" },
        "onet_soc": { "type": "string", "description": "O*NET-SOC code (US)" },
        "anzsco": { "type": "string", "description": "ANZSCO code (AU/NZ)" },
        "noc": { "type": "string", "description": "NOC 2021 code (CA)" },
        "cn_classification": { "type": "string", "description": "中华人民共和国职业分类大典 code" },
        "esco": { "type": "string", "description": "ESCO URI or code (EU)" }
      },
      "additionalProperties": false
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["description", "weight", "ai_exposure", "automation_potential", "augmentation_potential", "human_dependency", "basis"],
        "properties": {
          "description": { "type": "string" },
          "weight": { "type": "number", "minimum": 0, "maximum": 1, "description": "Share of occupation time; weights should sum to ~1. O*NET importance as proxy = model inference." },
          "ai_exposure": { "type": "integer", "minimum": 0, "maximum": 4, "description": "Mapped to ILO-NASK gradient 0(none)-4(highest)" },
          "automation_potential": { "type": "integer", "minimum": 0, "maximum": 4 },
          "augmentation_potential": { "type": "integer", "minimum": 0, "maximum": 4 },
          "human_dependency": { "type": "integer", "minimum": 0, "maximum": 4, "description": "4 = requires trust/accountability/physicality/licensed judgment" },
          "robotics_exposure": { "type": "integer", "minimum": 0, "maximum": 4 },
          "basis": { "type": "string", "enum": ["Observed", "Historical trend", "Projection", "Scenario", "Model inference", "Opinion"] }
        },
        "additionalProperties": false
      }
    },
    "evidence": { "type": "array", "items": { "$ref": "evidence.json" } }
  },
  "additionalProperties": false
}
